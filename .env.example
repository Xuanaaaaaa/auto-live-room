# Copy this file to .env and fill values for your local machine.
# Keep .env private. Do not commit real tokens or API keys.

# Douyin live room id. All host scripts use this value by default:
# danmu fetcher, pipeline JSONL selection, and OBS text updater.
LIVE_ID=266454629091

# aibz token. Paste the token without the "Bearer " prefix.
AIBZ_TOKEN=

# Danmu structured JSONL. Leave both empty to use the default:
# $ROOT_DIR/弹幕提取/DouyinLiveWebFetcher/output/${LIVE_ID}_*.jsonl
DANMU_JSONL=
DANMU_JSONL_GLOB=

# Pipeline monitor options.
PIPELINE_FROM_START=0
PIPELINE_DRY_RUN=0
PIPELINE_NO_TTS=0
EVENTS_OUT=
TRACES_OUT=
AUDIO_DIR=
MONITOR_EVENTS_GLOB=
MONITOR_FROM_START=0
STARTUP_WAIT_SECONDS=30

# Doubao credentials. Required for non-dry-run narration/TTS.
# Prefer service-specific keys. DOUBAO_API_KEY is only a shared fallback
# when the same key is valid for both LLM and TTS.
DOUBAO_API_KEY=
DOUBAO_LLM_API_KEY=
DOUBAO_LLM_MODEL=
DOUBAO_LLM_BASE_URL=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_HTTP_URL=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_TTS_VOICE=
DOUBAO_TTS_FORMAT=
DOUBAO_TTS_SAMPLE_RATE=

# OBS options. OBS Studio itself still runs on the host machine.
OBS_PASSWORD=
OBS_HOST=localhost
OBS_PORT=4455

# OBS text updater options.
OBS_INPUT_NAME=当前查询
OBS_FILE=
OBS_LATEST_GLOB=
OBS_FIELD=raw_text
OBS_WRAP_WIDTH=36
OBS_MAX_LINES=3
OBS_DRY_RUN=0
OBS_ONCE=0
OBS_WATCH_MODE=poll

# OBS audio player options. This is a separate sidecar process that watches
# 链路监控/events/*.jsonl and plays completed TTS mp3 files through an OBS media source.
OBS_AUDIO_INPUT_NAME=岗位语音
OBS_AUDIO_EVENTS_FILE=
OBS_AUDIO_EVENTS_GLOB=
OBS_AUDIO_PATH_MODE=auto
OBS_AUDIO_FROM_START=0
OBS_AUDIO_DRY_RUN=0
OBS_AUDIO_ONCE=0
